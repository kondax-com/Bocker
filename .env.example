# Application
NODE_ENV=development
NEXT_PUBLIC_DEVELOP_URL=http://localhost:3000
NEXT_PUBLIC_DEPLOY_URL=https://replace-me.example

# Convex
CONVEX_DEPLOYMENT=dev:replace_me
NEXT_PUBLIC_CONVEX_URL=https://replace-me.convex.cloud
NEXT_PUBLIC_CONVEX_AUD=replace_me

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Server capabilities must use the same secret in Next.js and Convex.
# Optional dedicated secret; when omitted, CLERK_SECRET_KEY is used.
# INTERNAL_NOTIFICATION_SECRET=replace_with_a_random_secret_in_both_environments
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
CLERK_JWT_ISSUER_DOMAIN=https://replace-me.clerk.accounts.dev
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_REDIRECT_URL=/dashboard

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CHECKOUT_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_MICRO_PROD_ID=prod_replace_me
NEXT_PUBLIC_LITE_PROD_ID=prod_replace_me
NEXT_PUBLIC_PRO_PROD_ID=prod_replace_me
NEXT_PUBLIC_MICRO_MONTHLY_PRC_ID=price_replace_me
NEXT_PUBLIC_MICRO_YEARLY_PRC_ID=price_replace_me
NEXT_PUBLIC_LITE_MONTHLY_PRC_ID=price_replace_me
NEXT_PUBLIC_LITE_YEARLY_PRC_ID=price_replace_me
NEXT_PUBLIC_PRO_MONTHLY_PRC_ID=price_replace_me
NEXT_PUBLIC_PRO_YEARLY_PRC_ID=price_replace_me

# Application authentication
NEXT_PUBLIC_APP_COOKIE_SECRET=replace_me
APP_JWT_SECRET=replace_me
SYSMTE_COOKIE_SECRET=replace_me
SYSTEM_JWT_SECRET=replace_me

# GCP
GCP_AI_STUDIO_API_KEY=replace_me
GCP_PROJECT=replace_me
GCP_CLIENT_EMAIL=replace_me
GCP_PRIVATE_KEY=replace_me
NEXT_PUBLIC_GCP_PROJECT_ID=replace_me
NEXT_PUBLIC_GCP_STORAGE_BUCKET_NAME=replace_me
COMPANY_LINE_CHANNEL_ACCESS_TOKEN=replace_me
GCS_LIFECYCLE_ENABLED=false
GCS_HOT_TIER_DAYS=30
GCS_WARM_TIER_DAYS=90
GCP_MONITORING_ENABLED=false

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=replace_me
CLOUDFLARE_R2_ACCESS_KEY_ID=replace_me
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace_me
CLOUDFLARE_R2_BUCKET_NAME=bocker-images
NEXT_PUBLIC_CDN_DOMAIN=https://cdn.bocker.jp

# Session and integrations
NEXT_PUBLIC_LOGIN_SESSION=replace_me
NEXT_PUBLIC_SESSION_SERCRET=replace_me
NEXT_PUBLIC_CHANNEL_TALK_PLUGIN_KEY=replace_me
NEXT_PUBLIC_SUPABASE_URL=https://replace-me.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=replace-me@example.com

# Sentry is disabled during development by code; these flags can disable production reporting too.
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false
